<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Stellar.MinimalNameplate</RootNamespace>
    <AssemblyName>Stellar.MinimalNameplate</AssemblyName>
    <Version>2.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions"       Version="2.0.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/nameplate-icon.png" LogicalName="Stellar.MinimalNameplate.nameplate-icon.png" />
    <EmbeddedResource Include="Resources/friend-icon.png" LogicalName="Stellar.MinimalNameplate.friend-icon.png" />
    <EmbeddedResource Include="Resources/guild-icon.png" LogicalName="Stellar.MinimalNameplate.guild-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

  <!-- Deploy is a per-machine dev concern: the DeployPlugin target lives in Local.props (gitignored), imported at the
       top of this file. A CI/registry build has no Local.props, so it produces just the DLL — no deploy, no warning. -->
</Project>
