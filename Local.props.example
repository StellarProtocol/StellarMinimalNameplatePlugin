<Project>
  <PropertyGroup>
    <!-- Copy this file to Local.props (gitignored) and set the path to your local game_mini folder. -->
    <GameInstallDir>C:\path\to\game_mini</GameInstallDir>
  </PropertyGroup>

  <!-- Post-build: copy the built DLL to the game's plugin folder. Deploy is a per-machine concern, so it lives in
       Local.props (not the committed csproj) — a CI/registry build has no Local.props and just produces the DLL. -->
  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(GameInstallDir)' != ''">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(GameInstallDir)\stellar\plugins\minimalnameplate\" />
  </Target>
</Project>
